
#This git ignore is for the entire repository. It is based on the default gitIgnore for Next.js projects, with some additions for Vercel and Yarn.

# Dependencies
node_modules/
**/node_modules/

# Next.js build files
.next/
**/.next/
out/
build/
dist/

# Environment variables and secrets
.env
.env.*
!.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Vercel
.vercel/